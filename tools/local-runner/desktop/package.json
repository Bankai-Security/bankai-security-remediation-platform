{
  "name": "bankai-local-jenkins-companion",
  "version": "0.1.0",
  "private": true,
  "author": "Bankai Security",
  "description": "Bankai local Jenkins companion for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "set \"VITE_DEV_SERVER_URL=http://127.0.0.1:5174\" && concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "vite build",
    "package:win": "vite build && electron-builder --dir",
    "dist:win": "vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.3.4",
    "typescript": "~6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.bankai.localjenkinscompanion",
    "productName": "Bankai Companion",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{ "from": "../runner.mjs", "to": "runner.mjs" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}

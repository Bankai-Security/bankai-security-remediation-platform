+"""Prepare Python dependencies separately from network-isolated code execution."""
+from __future__ import annotations
+
+import hashlib
+import io
+import re
+from pathlib import PurePosixPath
+
+from docker.errors import ImageNotFound
+
+from quincy.sandbox.workspace import build_tar_archive
+
+
+def project_directory(files: dict[str, bytes], command: list[str]) -> str:
+    for argument in command:
+        path = PurePosixPath(argument)
+        if path.is_absolute() or '..' in path.parts:
+            continue
+        if argument not in files and not any(name.startswith(argument.rstrip('/') + '/') for name in files):
+            continue
+        parent = path.parent if argument in files else path
+        for candidate in [parent, *parent.parents]:
+            if (candidate / 'requirements.txt').as_posix() in files or (candidate / 'pyproject.toml').as_posix() in files:
+                return candidate.as_posix()
+    manifests = [str(PurePosixPath(name).parent) for name in files if PurePosixPath(name).name == 'requirements.txt']
+    return manifests[0] if len(manifests) == 1 else '.'
+
+
+def prepare_python_image(client, image: str, files: dict[str, bytes], command: list[str]) -> str:
+    if image != 'quincy-sandbox-python:latest':
+        return image
+    project = project_directory(files, command)
+    manifest = files.get((PurePosixPath(project) / 'requirements.txt').as_posix())
+    if not manifest:
+        return image
+    # Never pass repository Dockerfiles or application code to the builder.
+    # Only ordinary package requirements are supported by this automatic path.
+    for line in manifest.decode('utf-8').splitlines():
+        value = line.strip()
+        if value and not value.startswith('#') and (
+            not re.match(r'^[A-Za-z0-9][A-Za-z0-9_.\[\],-]*(?:\s*[<>=!~;].*)?$', value)
+            or '://' in value or '@' in value
+        ):
+            raise ValueError('Automatic Python sandbox requires package-index requirements; configure a custom image for local, URL, or recursive requirements.')
+    version = '3.12'
+    dockerfile = files.get('Dockerfile', b'').decode('utf-8', errors='replace')
+    match = re.search(r'^FROM\s+python:(3\.(?:9|1[0-4]))(?:[.\s-]|$)', dockerfile, re.MULTILINE | re.IGNORECASE)
+    if match:
+        version = match.group(1)
+    recipe = (
+        f'FROM python:{version}-slim\n'
+        'COPY requirements.txt /opt/quincy/requirements.txt\n'
+        'RUN python -m pip install --no-cache-dir -r /opt/quincy/requirements.txt\n'
+        'USER 10001:10001\nWORKDIR /workspace\n'
+    ).encode()
+    tag = 'quincy-python-deps:' + hashlib.sha256(recipe + manifest).hexdigest()[:24]
+    try:
+        return client.images.get(tag).id
+    except ImageNotFound:
+        pass
+    archive = build_tar_archive({'Dockerfile': recipe, 'requirements.txt': manifest})
+    built, _ = client.images.build(fileobj=io.BytesIO(archive), custom_context=True, tag=tag, rm=True, timeout=300)
+    return built.id

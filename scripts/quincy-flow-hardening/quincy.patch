+async def test_run_proof_of_vulnerability_runs_same_proof_before_and_after(tmp_path: Path) -> None:

+    repo = _write_repo(tmp_path)

+    finding = _finding()

+    after_tests = PytestSuiteRunResult(

+        command=["npm", "test"], passed=True, exit_code=0, stdout="after-ok", stderr="", duration_seconds=1.0

+    )

+    patch = Patch(

+        finding_fingerprint=finding.fingerprint,

+        attempt_number=1,

+        summary="s",

+        rationale="r",

+        test_diffs=[

+            FileDiff(

+                path="tests/pov.test.ts",

+                diff="--- /dev/null\n+++ b/tests/pov.test.ts\n@@ -0,0 +1,1 @@\n+test('exploit', () => {});\n",

+            )

+        ],

+    )

+    sandbox = FakeSandboxRunner([_fail_sandbox_result(), _ok_sandbox_result()])

+    settings = Settings(model_provider="fake")

+

+    result = await run_proof_of_vulnerability(repo, patch, sandbox, settings, after_tests)

+

+    assert result is not None

+    assert result.test_path == "tests/pov.test.ts"

+    assert result.ran_before_patch.passed is False

+    assert result.ran_after_patch is not after_tests

+    assert sandbox.calls[0].command == sandbox.calls[1].command

+    assert result.proves_vulnerability is True

+    assert result.proves_fix is True

+    assert len(sandbox.calls) == 2

+    assert sandbox.calls[0].command == [

+        "node",

+        "--experimental-strip-types",

+        "--test",

+        "tests/pov.test.ts",

+    ]

+


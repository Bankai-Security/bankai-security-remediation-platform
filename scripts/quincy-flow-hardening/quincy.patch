+
+def test_python_monorepo_runtime_does_not_mutate_node_defaults(tmp_path: Path):
+    (tmp_path / 'backend/tests').mkdir(parents=True)
+    settings = Settings(_env_file=None, model_provider='fake')
+    resolved = resolve_runtime(settings, tmp_path, 'backend/app/utils/report_export.py')
+    assert resolved.sandbox_image == 'quincy-sandbox-python:latest'
+    assert resolved.test_command == ['python', '-m', 'unittest', 'discover', '-s', 'backend/tests']
+    assert settings.test_command == ['npm', 'test']
+    assert settings.sandbox_image == 'quincy-sandbox-node:latest'
+
+
+def test_nested_node_project(tmp_path: Path):
+    (tmp_path / 'frontend').mkdir()
+    (tmp_path / 'frontend/package.json').write_text('{}')
+    settings = Settings(_env_file=None, model_provider='fake')
+    assert resolve_runtime(settings, tmp_path, 'frontend/src/app.ts').test_command == ['npm', '--prefix', 'frontend', 'test']
+
+
+def test_custom_runtime_is_preserved(tmp_path: Path):
+    settings = Settings(_env_file=None, model_provider='fake', sandbox_image='custom-python', test_command=['pytest'])
+    assert resolve_runtime(settings, tmp_path, 'app.py').test_command == ['pytest']
+
+
+def test_missing_diff_prefix_is_rejected_instead_of_silently_ignored():
+    with pytest.raises(PatchApplyError, match='missing diff prefix'):
+        apply_file_diff('def preview():\n    pass\n', '@@ -1,2 +1,1 @@\ndef preview():\n-    pass\n+    return 1\n')
+
+
+def test_ambiguous_offset_hunk_is_rejected():
+    with pytest.raises(PatchApplyError, match='ambiguous'):
+        apply_file_diff('intro\na\na\n', '@@ -1 +1 @@\n-a\n+b\n')
+
+
+@pytest.mark.parametrize('code,error', [(127, 'python unavailable'), (1, 'ModuleNotFoundError: app'), (1, 'SyntaxError: invalid syntax')])
+def test_environment_failure_does_not_prove_a_vulnerability(code, error):
+    result = ProofRun(command=['python'], passed=False, exit_code=code, stdout='', stderr=error, duration_seconds=0)
+    assert not PoVResult(test_path='test.py', ran_before_patch=result).proves_vulnerability

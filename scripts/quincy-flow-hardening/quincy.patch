+from pathlib import Path

+

+from quincy.config import Settings

+from quincy.scanners.base import RawFinding, ScanConfig

+from quincy.schemas.evidence import TestRunResult as PytestSuiteRunResult

+from quincy.schemas.finding import Finding, Location, Severity

+from quincy.schemas.patch import FileDiff, Patch

+from quincy.schemas.sandbox import SandboxJobSpec, SandboxResult

+from quincy.validation.baseline import run_baseline

+from quincy.validation.differential import run_differential

+from quincy.validation.poc import run_proof_of_vulnerability

+

+

+class FakeScanner:

+    name = "fake-scanner"

+

+    def __init__(self, findings: list[RawFinding]) -> None:

+        self._findings = findings

+

+    async def scan(self, repo_path: Path, config: ScanConfig) -> list[RawFinding]:

+        return self._findings

+

+

+class FakeSandboxRunner:

+    def __init__(self, results: list[SandboxResult]) -> None:

+        self._results = list(results)

+        self.calls: list[SandboxJobSpec] = []

+

+    async def run(self, spec: SandboxJobSpec) -> SandboxResult:

+        self.calls.append(spec)

+        return self._results.pop(0)

+

+

+def _finding() -> Finding:

+    return Finding.build(

+        rule_id="BANKAI-001",

+        rule_version="1.0.0",

+        title="SQL Injection",

+        severity=Severity.HIGH,

+        location=Location(file="src/db.ts", start_line=2, end_line=2),

+        message="unparameterized query",

+        code_snippet='db.query("SELECT * FROM users WHERE id = " + id)',

+        scanner="semgrep",

+        raw_scanner_id="semgrep:bankai-001-sql-injection",

+        severity_as_reported="ERROR",

+        cwe=["CWE-89"],

+    )

+

+

+def _raw_finding_matching(finding: Finding) -> RawFinding:

+    return RawFinding(

+        scanner="semgrep",

+        check_id="bankai-001-sql-injection",

+        file=finding.location.file,

+        start_line=finding.location.start_line,

+        end_line=finding.location.end_line,

+        message=finding.message,

+        severity="ERROR",

+        code_snippet=finding.code_snippet,

+        metadata={"rule_id": "BANKAI-001"},

+    )

+

+

+def _write_repo(tmp_path: Path) -> Path:

+    (tmp_path / "src").mkdir()

+    (tmp_path / "src" / "db.ts").write_text(

+        "export function getUser(db, id) {\n"

+        '  return db.query("SELECT * FROM users WHERE id = " + id);\n'

+        "}\n"

+    )

+    return tmp_path

+

+

+def _ok_sandbox_result() -> SandboxResult:

+    return SandboxResult(exit_code=0, stdout="ok", stderr="", timed_out=False, duration_seconds=1.0)

+

+

+def _fail_sandbox_result() -> SandboxResult:

+    return SandboxResult(exit_code=1, stdout="fail", stderr="", timed_out=False, duration_seconds=1.0)

+

+

+async def test_run_baseline_reports_finding_present_and_tests(tmp_path: Path) -> None:

+    repo = _write_repo(tmp_path)

+    finding = _finding()

+    scanner = FakeScanner([_raw_finding_matching(finding)])

+    sandbox = FakeSandboxRunner([_ok_sandbox_result()])

+    settings = Settings(model_provider="fake")

+    default_config = ScanConfig(config_paths=[], timeout_seconds=30)

+

+    evidence = await run_baseline(

+        repo, finding, [scanner], {scanner.name: default_config}, default_config, sandbox, settings

+    )

+

+    assert evidence.scan.finding_present is True

+    assert evidence.tests.passed is True

+    assert len(sandbox.calls) == 1

+

+

+async def test_run_differential_shows_finding_gone_and_tests_passing(tmp_path: Path) -> None:

+    repo = _write_repo(tmp_path)

+    finding = _finding()

+    # after the patch, semgrep no longer finds the pattern

+    scanner = FakeScanner([])

+    sandbox = FakeSandboxRunner([_ok_sandbox_result()])

+    settings = Settings(model_provider="fake")

+

+    patch = Patch(

+        finding_fingerprint=finding.fingerprint,

+        attempt_number=1,

+        summary="parameterize",

+        rationale="avoid string concat",

+        file_diffs=[

+            FileDiff(

+                path="src/db.ts",

+                diff=(

+                    "--- a/src/db.ts\n+++ b/src/db.ts\n@@ -1,3 +1,3 @@\n"

+                    " export function getUser(db, id) {\n"

+                    '-  return db.query("SELECT * FROM users WHERE id = " + id);\n'

+                    '+  return db.query("SELECT * FROM users WHERE id = ?", [id]);\n'

+                    " }\n"

+                ),

+            )

+        ],

+    )

+

+    default_config = ScanConfig(config_paths=[], timeout_seconds=30)

+    result = await run_differential(

+        repo, finding, patch, [scanner], {scanner.name: default_config}, default_config, sandbox, settings

+    )

+

+    assert result.scan.finding_present is False

+    assert result.tests.passed is True

+    assert b"?" in result.patched_files["src/db.ts"]

+

+

+async def test_run_differential_reports_patch_apply_error_as_failed_validation(tmp_path: Path) -> None:

+    repo = _write_repo(tmp_path)

+    finding = _finding()

+    scanner = FakeScanner([])

+    sandbox = FakeSandboxRunner([])

+    settings = Settings(model_provider="fake")

+    patch = Patch(

+        finding_fingerprint=finding.fingerprint,

+        attempt_number=1,

+        summary="bad hunk",

+        rationale="context does not match",

+        file_diffs=[

+            FileDiff(

+                path="src/db.ts",

+                diff=(

+                    "--- a/src/db.ts\n+++ b/src/db.ts\n@@ -1,3 +1,3 @@\n"

+                    " export function getUser(db, id) {\n"

+                    "-  return db.query(\"wrong\");\n"

+                    "+  return db.query(\"SELECT * FROM users WHERE id = ?\", [id]);\n"

+                    " }\n"

+                ),

+            )

+        ],

+    )

+

+    default_config = ScanConfig(config_paths=[], timeout_seconds=30)

+    result = await run_differential(

+        repo, finding, patch, [scanner], {scanner.name: default_config}, default_config, sandbox, settings

+    )

+

+    assert result.scan.finding_present is True

+    assert result.tests.passed is False

+    assert "patch did not apply" in result.tests.stderr

+    assert sandbox.calls == []

+


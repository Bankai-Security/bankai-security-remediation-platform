+async def test_run_proof_of_vulnerability_returns_none_without_test_diffs(tmp_path: Path) -> None:

+    repo = _write_repo(tmp_path)

+    finding = _finding()

+    patch = Patch(finding_fingerprint=finding.fingerprint, attempt_number=1, summary="s", rationale="r")

+    sandbox = FakeSandboxRunner([])

+    settings = Settings(model_provider="fake")

+    after_tests = PytestSuiteRunResult(

+        command=["npm", "test"], passed=True, exit_code=0, stdout="", stderr="", duration_seconds=1.0

+    )

+

+    result = await run_proof_of_vulnerability(repo, patch, sandbox, settings, after_tests)

+    assert result is None

+    assert sandbox.calls == []

+


+"""Resolve built-in validation defaults per finding without mutating global settings."""
+from pathlib import Path
+
+from quincy.config import Settings
+
+
+def resolve_runtime(settings: Settings, repo_root: Path, target: str) -> Settings:
+    # An explicit custom image/command remains the operator's responsibility.
+    # The built-in Node defaults must not leak into Python jobs in a monorepo.
+    if settings.sandbox_image.split(":", 1)[0] != "quincy-sandbox-node" or settings.test_command != ["npm", "test"]:
+        return settings.model_copy(deep=True)
+    suffix = Path(target).suffix.lower()
+    if suffix == ".py" or Path(target).name in {"requirements.txt", "pyproject.toml", "Pipfile", "poetry.lock"}:
+        parent = (repo_root / target).parent
+        while parent.is_relative_to(repo_root):
+            tests = parent / "tests"
+            if tests.is_dir():
+                command = ["python", "-m", "unittest", "discover", "-s", tests.relative_to(repo_root).as_posix()]
+                break
+            if parent == repo_root:
+                command = ["python", "-m", "unittest", "discover"]
+                break
+            parent = parent.parent
+        return settings.model_copy(update={"sandbox_image": "quincy-sandbox-python:latest", "test_command": command})
+    if suffix == ".go" or Path(target).name == "go.mod":
+        return settings.model_copy(update={"sandbox_image": "quincy-sandbox-go:latest", "test_command": ["go", "test", "./..."]})
+    if suffix in {".js", ".jsx", ".ts", ".tsx"} or Path(target).name in {"package.json", "package-lock.json"}:
+        parent = (repo_root / target).parent
+        while parent.is_relative_to(repo_root):
+            if (parent / "package.json").is_file():
+                relative = parent.relative_to(repo_root).as_posix()
+                command = ["npm", "test"] if relative == "." else ["npm", "--prefix", relative, "test"]
+                return settings.model_copy(update={"test_command": command})
+            if parent == repo_root:
+                break
+            parent = parent.parent
+    return settings.model_copy(deep=True)

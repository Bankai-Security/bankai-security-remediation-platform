+"""Proof-of-vulnerability: an executable test that fails against the

+unpatched code (the exploit reproduces) and passes once the patch is

+applied. The model is asked to include exactly one such test, taken by

+convention as the first entry in `Patch.test_diffs`.

+

+Reuses the differential run's "after" test result instead of re-executing

+the full suite a third time per attempt â€” this function only needs one

+additional sandbox run: original source + the new test file(s), without

+the source fix.

+"""

+

+from __future__ import annotations

+

+from pathlib import Path

+

+from quincy.config import Settings

+from quincy.sandbox.runner import SandboxRunner

+from quincy.schemas.evidence import PoVResult, TestRunResult

+from quincy.schemas.patch import Patch

+from quincy.validation.patching import PatchApplyError, apply_patch, read_repo_files

+from quincy.validation.sandbox_exec import build_sandbox_spec, pick_test_command

+

+

+async def run_proof_of_vulnerability(

+    repo_root: Path,

+    patch: Patch,

+    sandbox: SandboxRunner,

+    settings: Settings,

+    after_tests: TestRunResult,

+) -> PoVResult | None:

+    if not patch.test_diffs:

+        return None

+    pov_path = patch.test_diffs[0].path

+

+    original_files = read_repo_files(repo_root)

+    test_only_paths = [d.path for d in patch.test_diffs]

+    try:

+        before_files = apply_patch(original_files, patch, diffs=test_only_paths)

+        after_files = apply_patch(original_files, patch)

+    except PatchApplyError as exc:

+        before_tests = TestRunResult(

+            command=pick_test_command(pov_path, settings.test_command),

+            passed=True,

+            exit_code=0,

+            stdout="",

+            stderr=f"proof-of-vulnerability test did not apply: {exc}",

+            duration_seconds=0.0,

+        )

+        return PoVResult(test_path=pov_path, ran_before_patch=before_tests, ran_after_patch=after_tests)

+

+    command = pick_test_command(pov_path, settings.test_command)

+    spec = build_sandbox_spec(settings, before_files, command)

+    sandbox_result = await sandbox.run(spec)

+    before_tests = TestRunResult(

+        command=command,

+        passed=sandbox_result.succeeded,

+        exit_code=sandbox_result.exit_code,

+        stdout=sandbox_result.stdout,

+        stderr=sandbox_result.stderr,

+        duration_seconds=sandbox_result.duration_seconds,

+    )

+

+    after_result = await sandbox.run(build_sandbox_spec(settings, after_files, command))

+    proof_after = TestRunResult(

+        command=command, passed=after_result.succeeded, exit_code=after_result.exit_code,

+        stdout=after_result.stdout, stderr=after_result.stderr,

+        duration_seconds=after_result.duration_seconds,

+    )

+    return PoVResult(test_path=pov_path, ran_before_patch=before_tests, ran_after_patch=proof_after)


{
  "name": "infrastructure",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "format:check": "node scripts/check-format.mjs",
    "watch": "tsc -w",
    "test": "jest",
    "test:determinism": "node scripts/verify-deterministic-synth.mjs",
    "validate:templates": "node scripts/validate-templates.mjs",
    "validate:jenkins": "node scripts/validate-jenkins-config.mjs",
    "validate:release": "node ../scripts/ci/validate-release-jenkinsfile.mjs && node --test ../scripts/release/release-policy.test.mjs",
    "validate:e2e": "node ../scripts/ci/validate-e2e-jenkinsfile.mjs && node --test ../e2e/run.test.mjs",
    "synth:nonprod": "cdk synth -c stage=nonprod --quiet",
    "synth:production": "cdk synth -c stage=production --quiet",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "jest": "^30",
    "aws-cdk": "2.1142.0",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.5.0"
  }
}

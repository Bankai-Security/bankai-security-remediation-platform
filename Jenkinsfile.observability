pipeline {
  agent { label 'trusted-docker' }
  options { disableConcurrentBuilds(); timestamps(); timeout(time: 30, unit: 'MINUTES') }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Validate native definitions') {
      steps { sh 'npm --prefix infrastructure ci --no-audit --no-fund && npm --prefix infrastructure run build && npm --prefix infrastructure run validate:observability' }
    }
    stage('Read nonproduction inventory') { steps { sh 'node scripts/operations/inventory.mjs' } }
  }
  post { always { archiveArtifacts artifacts: 'reports/readiness/**', allowEmptyArchive: false } }
}

pipeline {
  agent { label 'linux' }
  options { disableConcurrentBuilds(); timestamps(); timeout(time: 20, unit: 'MINUTES') }
  parameters {
    choice(name: 'OBSERVABILITY_ACTION', choices: ['baseline', 'metrics', 'dashboards', 'monitor-validate', 'monitors', 'dry-run'], description: 'Collect a read-only baseline, validate monitors, or apply one reviewed Datadog gate at a time.')
  }
  environment { DATADOG_SITE = 'datadoghq.com' }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Apply Datadog configuration') {
      steps {
        withCredentials([
          string(credentialsId: 'jenkins-datadog-api-key', variable: 'DD_API_KEY'),
          string(credentialsId: 'jenkins-datadog-app-key', variable: 'DD_APP_KEY')
        ]) {
          sh '''
            set -eu
            case "$OBSERVABILITY_ACTION" in
              baseline) node scripts/observability/configure-datadog.mjs --baseline ;;
              metrics) node scripts/observability/configure-datadog.mjs --metrics ;;
              dashboards) node scripts/observability/configure-datadog.mjs --dashboards ;;
              monitor-validate) node scripts/observability/configure-datadog.mjs --monitor-validate ;;
              monitors) node scripts/observability/configure-datadog.mjs --monitors ;;
              dry-run) node scripts/observability/configure-datadog.mjs --all --dry-run ;;
              *) echo "unsupported action: $OBSERVABILITY_ACTION" >&2; exit 2 ;;
            esac
          '''
        }
      }
    }
  }
  post { always { archiveArtifacts artifacts: 'reports/observability/**', allowEmptyArchive: true } }
}
